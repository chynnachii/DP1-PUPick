/* ==================== DESIGN TOKENS ==================== */

:root {
  /* Color system: semantic tokens only, roughly 60 / 30 / 10.
       60%  page background and neutral space   (--color-bg-*)
       30%  cards, panels, controls             (--color-surface-*, borders)
       10%  brand maroon (actions, selection, key figures) and gold (cart pill, notices, badges)
     Text/background pairs are >= 4.5:1; control outlines (--color-border-strong) are >= 3:1.
     Same role = same token: no one-off hex values in components. */

  /* Backgrounds and surfaces */
  --color-bg-page: #f6f3f0;
  --color-bg-subtle: #ece8e3;           /* tracks, inactive fills */
  --color-surface: #ffffff;             /* cards, controls */
  --color-surface-elevated: #ffffff;    /* modals; separated by shadow and scrim, not tint */
  --color-surface-hover: #fdf0cf;       /* pressed choice buttons */
  --color-surface-selected: #7a0000;    /* selected chips and categories (same as primary) */
  --color-surface-disabled: #e9e4de;
  --color-surface-inverse: #4a0d14;     /* toast */
  --color-backdrop: #1a1a1a;            /* letterbox outside the kiosk canvas */
  --color-scrim: rgba(42, 10, 14, .62); /* modal overlay */
  --color-scroll-shadow: rgba(74, 13, 20, .18); /* edge hint that a scroll region has more content */

  /* Primary: main actions, selection, key figures */
  --color-primary: #7a0000;
  --color-primary-hover: #a02020;
  --color-primary-active: #4a0d14;
  --color-primary-bg: #f6e1e3;          /* placeholder image gradient */

  /* Secondary: outlined / subordinate actions */
  --color-secondary: #ffffff;
  --color-secondary-hover: #fdf0cf;
  --color-secondary-active: #f7e0a4;

  /* Accent: meaningful emphasis (cart pill, notices, badges) */
  --color-accent: #f1b434;
  --color-accent-bg: #fdf0cf;

  /* Text */
  --color-text-primary: #212529;
  --color-text-heading: #4a0d14;        /* brand-tinted near-black for titles */
  --color-text-secondary: #495057;
  --color-text-muted: #5c636a;          /* metadata and captions; >= 5:1 */
  --color-text-disabled: #8a8f94;
  --color-text-on-primary: #ffffff;
  --color-text-on-accent: #4a0d14;

  /* Lines */
  --color-border: #ddd7d0;              /* card edges (decorative) */
  --color-border-strong: #82878d;       /* interactive control outlines (>= 3:1) */
  --color-divider: #e7e2dc;             /* rules inside a surface */

  /* Feedback: always paired with text or an icon, never colour alone */
  --color-success: #1f7a45;
  --color-success-bg: #dff3e7;
  --color-success-text: #17603a;
  --color-warning-bg: #fff1d6;
  --color-warning-text: #7a4800;
  --color-error: #b3261e;
  --color-error-hover: #9a1f18;
  --color-error-active: #8a1a14;
  --color-error-bg: #fbe3e1;
  --color-error-text: #9a1f18;
  --color-info-bg: #e6f0fb;             /* informational states (payment due at the stall) */
  --color-info-text: #174a85;

  --color-focus: #1e5fa8;

  --r: 20px;
  --r-sm: 12px;
  --shadow: 0 2px 6px rgba(74, 13, 20, .08), 0 8px 24px rgba(74, 13, 20, .07);
  --fs: 20px;
  --page-pad: 2.5rem;   /* shared container edge: <main>, the cart pill and scroll regions key off it */

  /* Spacing scale: sp-1/sp-2 related items, sp-3/sp-4 inside a component, sp-5/sp-6 groups and sections */
  --sp-1: .5rem;
  --sp-2: .75rem;
  --sp-3: 1rem;
  --sp-4: 1.5rem;
  --sp-5: 2rem;
  --sp-6: 3rem;
  --card-pad: 1.6rem;   /* inner padding of every card, so text edges line up across stacked cards */
  --control-h: 64px;    /* shared height of toolbar controls (buttons, search field) */
  --measure: 760px;     /* width of centered confirmation content */
  --t: .18s ease;
  --t-fast: .1s ease;   /* press feedback and in-place state changes */
  --fab-gap: 1.5rem;    /* space between the last content row and the cart pill */
  --modal-pad: 2.25rem;
  --pay-card-h: 680px;  /* height of the payment card on the kiosk canvas */
}

/* ==================== BASE / RESET ==================== */

* {
  box-sizing: border-box;
  margin: 0;
  touch-action: manipulation;   /* no double-tap-zoom delay; scrolling and pinch are unaffected */
  scrollbar-width: none;        /* scrollbars hidden everywhere; scrolling still works */
}

*::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

html,
body {
  height: 100%;
  overflow: hidden;
  overscroll-behavior: none;    /* no pull-to-refresh or rubber-banding of the whole page */
}

body {
  display: grid;
  place-items: center;
  font-family: 'Satoshi', system-ui, sans-serif;
  font-size: var(--fs);
  line-height: 1.4;
  color: var(--color-text-primary);
  background: var(--color-backdrop);
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}

button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .6rem;
  min-height: var(--control-h);
  padding: .8rem 1.6rem;
  font: inherit;
  font-weight: 700;
  color: inherit;
  background: none;
  border: 0;
  border-radius: var(--r-sm);
  cursor: pointer;
  transition: transform var(--t-fast), background var(--t), box-shadow var(--t);
}

svg {
  flex: none;
  width: 1.5em;
  height: 1.5em;
}

input,
textarea {
  user-select: text;
}

textarea {
  width: 100%;
  min-height: 90px;
  padding: 1rem;
  font: inherit;
  border: 2px solid var(--color-border-strong);
  border-radius: var(--r-sm);
  resize: none;
}

/* ==================== SHARED COMPONENTS ==================== */
/* Used by more than one screen. Screen-only rules live in their SCREEN section. */

/* ---------- App shell ---------- */

/* Fixed 1080x1920 portrait canvas; --kiosk-scale is set by fitKiosk() in script.js */
.kiosk {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 1080px;
  height: 1920px;
  background: var(--color-bg-page);
  border-radius: 12px;
  box-shadow: 0 0 60px rgba(0, 0, 0, .6);
  overflow: hidden;
  transform: scale(var(--kiosk-scale, 1));
  transform-origin: center center;
}

/* The shell never scrolls: screens hand out their height and only .scroll regions move */
main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;                /* lets the flex chain shrink below its content */
  padding: var(--page-pad);
  overflow: hidden;
  overflow: clip;               /* unlike hidden, clip cannot be scrolled by focus or scrollIntoView */
  outline: 0;
}

/* Only go() in script.js re-renders .screen, so only a new screen plays this entrance animation.
   In-screen changes (filters, quantities, payment status) update in place and never replay it. */
.screen {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
  animation: in .25s ease;
}

/* ---------- Scroll regions ---------- */

/* A screen is a flex column of fixed regions (header, toolbar, footer) plus at most one .scroll region
   taking the remaining height. Requirements: every flex/grid ancestor of a scroll region has
   min-height: 0, fixed regions never shrink, and overscroll-behavior: contain stops a fling at the
   end of a list from moving anything else.
   .bleed runs a region to the canvas edges so card shadows are not clipped. */
.screen > * {
  flex-shrink: 0;
}

.scroll {
  --scroll-bg: var(--color-bg-page);
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  /* Scroll shadows: the first two layers (attached to the content) hide the shadow once an end is reached,
     the last two (attached to the box) show it while more content lies beyond that edge. Pure CSS. */
  background:
    linear-gradient(var(--scroll-bg) 30%, transparent) 0 0 / 100% 28px no-repeat local,
    linear-gradient(transparent, var(--scroll-bg) 70%) 0 100% / 100% 28px no-repeat local,
    radial-gradient(farthest-side at 50% 0, var(--color-scroll-shadow), transparent) 0 0 / 100% 12px no-repeat scroll,
    radial-gradient(farthest-side at 50% 100%, var(--color-scroll-shadow), transparent) 0 100% / 100% 12px no-repeat scroll;
}

.card .scroll,
.modal .scroll {
  --scroll-bg: var(--color-surface);
}

.screen > .scroll {
  flex: 1 1 0;
}

.scroll.bleed {
  margin-inline: calc(-1 * var(--sp-1)) calc(-1 * var(--page-pad));
  padding-inline: var(--sp-1) var(--page-pad);
  padding-bottom: var(--sp-4);  /* room for the last card's shadow above a footer */
}

.screen > .scroll.bleed:last-child,
.menu > .scroll.bleed {
  margin-bottom: calc(-1 * var(--page-pad));
  padding-bottom: var(--page-pad);
}

/* Safe area for the cart pill: --fab-clear (pill height + bottom inset) is measured in script.js, so the
   last menu row can always scroll clear of the pill */
.scroll.bleed.pad-fab {
  padding-bottom: max(var(--page-pad), calc(var(--fab-clear, 6rem) + var(--fab-gap)));
}

@media (prefers-reduced-motion: no-preference) {
.scroll {
    scroll-behavior: smooth;
  }
}

/* ---------- Layout patterns ---------- */

.row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-3);
}

/* Grouped CTAs share the row equally, so edges and heights match whatever the label lengths */
.row.actions > * {
  flex: 1 1 0;
}

/* Centered content group (confirmation screens): one center axis, one gap between blocks */
.confirm {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-4);
  text-align: center;
}

.confirm > .card,
.confirm > .details,
.confirm > .status,
.confirm > .notice {
  width: min(100%, var(--measure));
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  align-content: start;         /* rows keep their natural height when the container is taller than the content */
  grid-auto-rows: max-content;  /* ...and when it is shorter: a fixed-height grid would squash the rows */
  gap: var(--sp-4);
}

/* Stage: one centered group under the heading, lifted slightly (bottom padding) because the heading
   already occupies the top. Used by Payment and Order Confirmed. */
.stage {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  justify-content: safe center;   /* centered when it fits, top-aligned and scrollable when it does not */
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  gap: var(--sp-5);
  padding-bottom: calc(var(--sp-6) * 2);
}

.stage > * {
  width: 100%;
}

/* Centered variant: heading and group are centered together on the canvas (Order Confirmed) */
.screen.is-centered {
  justify-content: center;
  justify-content: safe center;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.is-centered .stage {
  flex: none;
  padding-bottom: 0;
  overflow: visible;
}

/* ---------- Buttons ---------- */

.btn-block {
  width: 100%;
}

/* Icon-only button: a square target instead of a text-button's horizontal padding */
.btn-icon {
  width: var(--control-h);
  padding: 0;
}

.btn-primary {
  color: var(--color-text-on-primary);
  background: var(--color-primary);
  box-shadow: var(--shadow);
}

.btn-secondary {
  color: var(--color-primary);
  background: var(--color-secondary);
  border: 2px solid var(--color-primary);
}

.btn-danger {
  color: var(--color-text-on-primary);
  background: var(--color-error);
}

.btn-quiet {
  color: var(--color-primary);
  background: none;
}

.btn-lg {
  min-height: 88px;
  padding: 1.2rem 3.2rem;
  font-size: 1.6rem;
  border-radius: var(--r);
}

/* ---------- Cart pill (#fab) ---------- */

/* Floating cart pill; shown only on FAB_SCREENS in script.js */
.fab {
  position: absolute;
  right: var(--page-pad);       /* same right edge as the content above it */
  bottom: var(--page-pad);
  z-index: 5;
  min-height: 76px;
  padding: 0 2rem;
  font-size: 1.3rem;
  color: var(--color-text-on-accent);
  background: var(--color-accent);
  border-radius: 99px;
  box-shadow: var(--shadow);
  animation: fade .15s ease;   /* replays each time the pill is shown */
}

.fab[hidden] {
  display: none;
}

.fab b {
  display: grid;
  place-items: center;
  min-width: 2.4rem;
  height: 2.4rem;
  color: var(--color-text-on-primary);
  background: var(--color-primary);
  border-radius: 99px;
}

/* ---------- Selectable pills (stall chips, menu categories) ---------- */

/* Filter buttons switch state instantly (only the press scale is animated) */
.chip,
.cat {
  background: var(--color-surface);
  border: 2px solid var(--color-border-strong);
  transition: transform var(--t-fast);
}

.chip[aria-pressed="true"],
.cat[aria-pressed="true"] {
  color: var(--color-text-on-primary);
  background: var(--color-surface-selected);
  border-color: var(--color-surface-selected);
}

/* ---------- Screen header ---------- */

.screen-head {
  margin-bottom: var(--sp-5);
}

.head-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--control-h);
  margin-bottom: var(--sp-1);
}

.step-label {
  margin-left: auto;
  font-size: .95rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.screen-head h1 {
  font-size: 2.6rem;
  font-weight: 900;
  line-height: 1.1;
  color: var(--color-text-heading);
}

.head-icon {
  display: flex;
  justify-content: center;
  margin: var(--sp-3) 0 var(--sp-4);
}

.lede {
  max-width: 36em;
  margin-top: var(--sp-1);
  font-size: 1.25rem;
  color: var(--color-text-secondary);
}

.screen-head.is-center {
  text-align: center;
}

.screen-head.is-center .head-nav {
  justify-content: center;
}

.screen-head.is-center .step-label {
  margin-left: 0;
}

.screen-head.is-center .lede {
  margin-inline: auto;
}

/* Optical edge alignment: the chevron sits on the container edge (same as the title below) while the
   hit area and hover tint extend past it by exactly the padding */
.back {
  margin-left: -.8rem;
  padding-left: .8rem;
  font-size: 1.15rem;
}

.back svg {
  width: 1.2em;
  height: 1.2em;
}

/* ---------- Surfaces ---------- */

.card {
  padding: var(--card-pad);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--r);
  box-shadow: var(--shadow);
}

/* Card title: close to its content, clearly subordinate to the screen's h1 */
.card > h2 {
  margin-bottom: var(--sp-3);
  font-size: 1.5rem;
  font-weight: 900;
  line-height: 1.15;
  color: var(--color-text-heading);
}

.tile {
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow: hidden;
}

.tile .body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--sp-1);
  padding: var(--sp-3) var(--sp-3) var(--sp-4);
}

.tile h3 {
  font-size: 1.4rem;
  line-height: 1.2;
}

/* The CTA row is pinned to the bottom of every tile, so buttons line up across a row of cards */
.tile .row {
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: var(--sp-2);
}

.ph {
  display: grid;
  place-items: center;
  aspect-ratio: 16 / 9;
  font-size: 3.5rem;
  background: linear-gradient(135deg, var(--color-accent-bg), var(--color-primary-bg));
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  width: fit-content;
  padding: .2rem .8rem;
  font-size: .95rem;
  font-weight: 700;
  color: var(--color-text-on-accent);
  background: var(--color-accent-bg);
  border-radius: 99px;
}

.muted {
  font-size: 1rem;
  color: var(--color-text-muted);
}

.price {
  font-size: 1.35rem;
  font-weight: 900;
  color: var(--color-primary);
}

.notice {
  padding: var(--sp-3) 1.2rem;
  font-size: 1.1rem;
  font-weight: 500;
  background: var(--color-accent-bg);
  border-left: 6px solid var(--color-accent);
  border-radius: var(--r-sm);
}

.notice.is-lg {
  font-size: 1.4rem;
  font-weight: 700;
}

/* Payment note: bold lead line, regular supporting line */
.notice.is-lg p + p {
  margin-top: var(--sp-1);
  font-size: 1.15rem;
  font-weight: 500;
}

/* Inside a card the notice sits between two groups, so it gets group-level spacing */
.card .notice {
  margin: var(--sp-4) 0;
}

/* A start-aligned stripe beside centered text reads as off-center, so centered notices carry it on top */
.confirm .notice {
  border-top: 6px solid var(--color-accent);
  border-left: 0;
}

.empty {
  padding: 3rem 1rem;
  text-align: center;
  color: var(--color-text-muted);
}

.empty .em {
  font-size: 4rem;
}

/* ---------- Quantity stepper (cart lines, item picker) ---------- */

.step {
  display: inline-flex;
  align-items: center;
  background: var(--color-surface);
  border: 2px solid var(--color-border-strong);
  border-radius: var(--r-sm);
}

.step button {
  min-width: 52px;
  min-height: 52px;
  padding: 0;
  font-size: 1.5rem;
}

.step output {
  min-width: 2.5rem;
  font-size: 1.2rem;
  font-weight: 900;
  text-align: center;
}

/* ---------- Status messages ---------- */

.status {
  display: flex;
  gap: var(--sp-3);
  align-items: center;
  padding: 1.1rem 1.4rem;
  font-size: 1.15rem;
  font-weight: 700;
  border-radius: var(--r-sm);
}

/* Centered stacks: a short status is part of the centered composition, not a left-aligned strip */
.confirm .status {
  justify-content: center;
  text-align: left;
}

/* Modal status sits above the text that follows, so it carries the group gap */
.modal .status {
  margin-bottom: var(--sp-3);
}

.s-wait { color: var(--color-info-text);    background: var(--color-info-bg); }

.s-ver  { color: var(--color-warning-text); background: var(--color-warning-bg); }

.s-bad  { color: var(--color-error-text);   background: var(--color-error-bg); }

/* ---------- Label / value facts ---------- */

.fact-label {
  font-size: .95rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.fact-value {
  overflow-wrap: anywhere;
  font-size: 1.7rem;
  font-weight: 900;
  line-height: 1.1;
  color: var(--color-text-heading);
}

/* ---------- Modal system (overlay, content modals, dialogs) ---------- */

/* One overlay + one shell for every popup; data-kind on #modal picks the content style:
     dialog   compact, centered alert/confirmation (idle warning, confirmations)  -> .dialog
     content  titled panel with a Close button, left-aligned (item picker, queue, help)
   Motion: the overlay fades in/out and the panel eases in with a tiny scale. No slides or bounces. */
.overlay {
  position: absolute;
  inset: 0;
  z-index: 20;
  display: grid;
  grid-template: minmax(0, 1fr) / minmax(0, 1fr);   /* definite track so the panel's max-height: 100% works */
  place-items: center;
  padding: 1.5rem;
  background: var(--color-scrim);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);                        /* the screen behind recedes instead of competing */
  animation: fade .15s ease;
}

.overlay[hidden] {
  display: none;
}

.overlay.is-closing {
  pointer-events: none;
  animation: fade-out .12s ease forwards;            /* keep MODAL_FADE_MS in script.js in sync */
}

.modal {
  width: min(720px, 100%);
  max-height: 100%;
  padding: var(--modal-pad);
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  background: var(--color-surface-elevated);
  border-radius: 28px;
  box-shadow: 0 24px 64px rgba(42, 10, 14, .35);
  animation: modal-in .18s ease;
}

.modal[data-kind="dialog"] {
  width: min(620px, 100%);
}

/* Content modals: title row and action bar stay fixed, only the body scrolls */
.modal[data-kind="content"] {
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow: hidden;
}

.modal[data-kind="content"] .mhead {
  flex: none;
  margin: 0;
  padding: var(--modal-pad) var(--modal-pad) var(--sp-3);
}

.modal-body {
  flex: 1 1 auto;
  padding: 0 var(--modal-pad) var(--sp-4);
}

.modal-foot {
  flex: none;
  padding: var(--sp-3) var(--modal-pad) var(--modal-pad);
  border-top: 1px solid var(--color-divider);
}

/* ---------- Content modals: title row ---------- */
.mhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.mhead h2 {
  font-size: 1.8rem;
  font-weight: 900;
  line-height: 1.15;
  color: var(--color-text-heading);
}

/* ---------- Dialogs: icon > title > message > (extra) > actions, all centered ---------- */
.dialog {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.dialog-icon {
  display: grid;
  place-items: center;
  width: 92px;
  height: 92px;
  margin-bottom: var(--sp-4);
  border-radius: 50%;
}

.dialog-icon svg {
  width: 48px;
  height: 48px;
}

/* Tone is chosen by showDialog() as is-${tone} */
.dialog-icon.is-gold {
  color: var(--color-primary);
  background: var(--color-accent-bg);
}

.dialog-icon.is-danger {
  color: var(--color-error);
  background: var(--color-error-bg);
}

.dialog-title {
  margin-bottom: var(--sp-2);
  font-size: 2.3rem;
  font-weight: 900;
  line-height: 1.1;
  color: var(--color-text-heading);
}

.dialog-msg {
  max-width: 21em;                  /* comfortable, balanced measure for long copy */
  font-size: 1.3rem;
  font-weight: 500;
  line-height: 1.45;
  color: var(--color-text-secondary);
  text-wrap: balance;
}

.dialog-count {
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  color: var(--color-primary);
}

.dialog-count #wc {
  display: inline-block;
  min-width: 1.2ch;                 /* "10" -> "9" does not shift the sentence */
  text-align: center;
}

/* Countdown bar: advanced by the same one-second tick as the number, easing linearly between ticks */
.dialog-timer {
  width: min(100%, 360px);
  height: 10px;
  margin-top: 1.5rem;
  overflow: hidden;
  background: var(--color-bg-subtle);
  border-radius: 99px;
}

.dialog-timer i {
  display: block;
  height: 100%;
  background: var(--color-primary);
  border-radius: inherit;
  transform-origin: left center;
  transition: transform 1s linear;
}

.dialog-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  width: 100%;
  margin-top: var(--sp-5);
}

.dialog-actions button {
  flex: 1 1 0;
  min-width: 0;
  min-height: 76px;
  font-size: 1.3rem;
  line-height: 1.2;
  text-align: center;
  transition: transform var(--t-fast), background var(--t-fast);
}

.dialog-actions .btn-lg {
  min-height: 88px;
  padding-inline: 1.6rem;
  font-size: 1.5rem;
}

.dialog-actions > :only-child {
  flex: 0 1 440px;                  /* a lone CTA is wide, centered and never stretched edge to edge */
}

/* Immediate press feedback (subtle: tint plus a 2% squeeze) */
.dialog-actions button:active:not(:disabled) {
  transform: scale(.98);
}

.dialog-actions .btn-primary:active:not(:disabled) { background: var(--color-primary-active); }

.dialog-actions .btn-danger:active:not(:disabled) { background: var(--color-error-active); }

.dialog-actions .btn-secondary:active:not(:disabled) { background: var(--color-secondary-active); }

.modal p + p {
  margin-top: var(--sp-1);
}

/* ---------- Toast ---------- */

.toast {
  position: fixed;              /* fixed elements add no scrollable overflow, so the hidden toast cannot make the page scroll */
  bottom: 12rem;                /* clears the cart pill */
  left: 50%;
  z-index: 30;
  padding: 1.2rem 2.2rem;
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--color-text-on-primary);
  background: var(--color-surface-inverse);
  border-radius: 99px;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 150%);
  transition: transform .25s, opacity .25s, visibility .25s;
}

.toast.show {
  visibility: visible;
  opacity: 1;
  transform: translate(-50%, 0);
}

/* ==================== SCREEN: HOME ==================== */
/* Welcome screen, plus the queue and help modals it opens. */

.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  justify-content: safe center;
  gap: var(--sp-6);
  height: 100%;
  overflow-y: auto;
  overscroll-behavior: contain;
  text-align: center;
}

/* One CTA column: the primary button and the secondary pair share the same left and right edges */
.welcome-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--sp-3);
  width: min(100%, 520px);
}

.welcome-actions .row {
  flex-wrap: nowrap;
}

.welcome-actions .row > * {
  flex: 1 1 0;
}

.welcome h2 {
  margin-bottom: var(--sp-3);
  font-size: 3.5rem;
  font-weight: 900;
  line-height: 1.08;
  color: var(--color-text-heading);
}

.welcome h2 em {
  color: var(--color-primary-hover);
}

.welcome-intro p {
  font-size: 1.3rem;
  color: var(--color-text-secondary);
}

.hero {
  width: min(100%, 720px);
  padding: 2rem;
  text-align: center;
  background: linear-gradient(160deg, var(--color-accent-bg), var(--color-surface));
  border: 1px solid var(--color-border);
  border-radius: 32px;
}

.hero svg {
  display: block;               /* no inline baseline gap under the illustration */
  width: min(340px, 40vh);
  height: auto;
  margin: 0 auto var(--sp-4);
}

/* Caption and its dots form one group; the carousel in script.js toggles .swap and .on */
.slide {
  min-height: 1.6em;
  margin-bottom: var(--sp-2);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--color-primary);
  transition: opacity .25s ease, transform .25s ease;
}

.dots {
  display: flex;
  justify-content: center;
  gap: .6rem;
}

.dots i {
  width: 12px;
  height: 12px;
  background: var(--color-border-strong);
  border-radius: 99px;
  transition: var(--t);
}

.dots i.on {
  width: 34px;
  background: var(--color-primary);
}

.slide.swap {
  opacity: 0;
  transform: translateY(6px);
}

/* ---------- Queue and help modals ---------- */

/* Order-tracking QR view (opened from Home and from the Complete screen) */
.qr-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-3);
  text-align: center;
}

.qr-code {
  width: min(100%, 480px);
  aspect-ratio: 1;
  overflow: hidden;
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--r-sm);
}

.qr-code svg {
  display: block;
  width: 100%;
  height: 100%;
}

.qr-instruction {
  max-width: 26ch;
  font-size: 1.5rem;
  font-weight: 900;
  line-height: 1.25;
  color: var(--color-text-heading);
}

/* ---------- Info modals ---------- */
.modal-list {
  padding-left: 1.4rem;
}

.modal-list li + li {
  margin-top: var(--sp-2);
}

.modal-list + p {
  margin-top: var(--sp-4);
}

@media (max-width: 760px) {
.welcome h2 {
    font-size: 2.4rem;
  }

.hero svg {
    width: min(200px, 30vh);
  }
}

/* ==================== SCREEN: STALLS ==================== */
/* Step 1: search, category chips and the stall grid (.grid and .tile are shared). */

.toolbar {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-bottom: var(--sp-3);
}

/* Same height as the button beside it, so top and bottom edges match */
.search {
  display: flex;
  flex: 1;
  align-items: center;
  gap: var(--sp-2);
  min-width: 240px;
  min-height: var(--control-h);
  padding: 0 var(--sp-3);
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: 2px solid var(--color-border-strong);
  border-radius: var(--r-sm);
}

.search input {
  flex: 1;
  align-self: stretch;
  min-width: 0;
  font: inherit;
  background: none;
  border: 0;
  outline: 0;
}

.chips {
  display: flex;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
  padding-bottom: var(--sp-1);
  overflow-x: auto;
  overscroll-behavior-x: contain;
}

.chip {
  padding: .6rem 1.4rem;
  font-size: 1.1rem;
  white-space: nowrap;
  border-radius: 99px;
}

@media (max-width: 760px) {
.toolbar {
    flex-wrap: wrap;
  }
}

/* ==================== SCREEN: MENU ==================== */
/* Step 2: category list and item grid, plus the item picker modal. */

.grid.is-menu {
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
}

.menu {
  display: grid;
  flex: 1 1 0;
  grid-template-columns: 260px minmax(0, 1fr);
  grid-template-rows: minmax(0, 1fr);
  gap: var(--sp-4);
  min-height: 0;
}

.cats {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  min-height: 0;
  overflow-y: auto;             /* only matters on short viewports; the six categories normally fit */
  overscroll-behavior-x: contain;
}

.cat {
  justify-content: flex-start;
  font-size: 1.15rem;
  text-align: left;
}

/* ---------- Item picker modal ---------- */

/* ---------- Item picker: one rhythm of sections, each heading close to its content ---------- */
.opt {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  min-height: 60px;
  padding: var(--sp-3) 1.2rem;
  font-size: 1.1rem;
  border: 2px solid var(--color-border-strong);
  border-radius: var(--r-sm);
  cursor: pointer;
}

.opt input {
  width: 28px;
  height: 28px;
  accent-color: var(--color-primary);
}

.opt span:last-child {
  margin-left: auto;
  font-weight: 700;
}

.modal-ph {
  border-radius: var(--r-sm);
}

.modal-section {
  margin-top: var(--sp-4);
}

.modal-section h3 {
  margin-bottom: var(--sp-2);
  font-size: 1.15rem;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
}

.opts {
  display: grid;
  gap: var(--sp-2);
}

.field {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

@media (max-width: 760px) {
.menu {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
  }

.cats {
    flex-direction: row;
    overflow-x: auto;
    overflow-y: hidden;
  }

.cat {
    white-space: nowrap;
  }
}

/* ==================== SCREEN: CART ==================== */
/* Step 3: item list, order summary and actions. */

/* Cart: a short order keeps its natural height with the actions right beneath it. Once the order outgrows
   the screen, only the item list (.cart-lines) scrolls; the summary and the actions never move. */
.screen > .split {
  flex: 0 1 auto;
  min-height: 0;
}

.split {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.split > .cart-items {
  display: flex;
  flex: 0 1 auto;
  flex-direction: column;
  min-height: 0;
}

.split > .cart-summary,
.split > .row.actions {
  flex: none;
}

.cart-lines {
  flex: 0 1 auto;
}

.line {
  display: grid;
  grid-template-columns: 80px 1fr auto auto;
  gap: var(--sp-4);
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1px solid var(--color-divider);
}

.line-info b {
  font-size: 1.25rem;
  line-height: 1.2;
}

.line-info .muted {
  margin-top: .15rem;
}

.line .ph {
  width: 80px;
  aspect-ratio: 1;
  font-size: 2.2rem;
  border-radius: var(--r-sm);
}

.sum {
  display: flex;
  justify-content: space-between;
  padding: var(--sp-1) 0;
  font-size: 1.15rem;
}

/* Values are <dd>: tabular so amounts and times line up down the right edge; the Total keeps its own weight */
.sum dd {
  font-variant-numeric: tabular-nums;
}

.sum:not(.tot) dd {
  font-weight: 700;
}

.sum.tot {
  margin-top: var(--sp-1);
  padding-top: var(--sp-3);
  font-size: 1.8rem;
  font-weight: 900;
  color: var(--color-primary);
  border-top: 2px dashed var(--color-divider);
}

@media (max-width: 760px) {
  /* Thumbnail spans two rows; name and meta fill the first, quantity and remove share the second */
.line {
    grid-template-columns: 64px 1fr auto;
    gap: var(--sp-2) var(--sp-3);
  }

.line .ph {
    align-self: start;
    grid-row: span 2;
    width: 64px;
  }

.line-info {
    grid-column: 2 / -1;
  }

.line .step {
    justify-self: start;
  }

.line .btn-icon {
    justify-self: end;
  }
}

/* ==================== SCREEN: PAYMENT ==================== */
/* Step 4: total and the single Payment option. */

/* The option card spans the full content width. The height is the flex-basis: the card holds its size when
   there is room and shrinks (never below the touch-comfortable minimum) on a shorter canvas. */
.pay {
  display: grid;
  flex: 0 1 var(--pay-card-h);
  grid-template-columns: 1fr;
  gap: var(--sp-4);
  min-height: 360px;
}

/* Total sits on the same left and right edges as the cards below it */
.pay-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-3);
}

/* Payment card: icon badge > name > one line of description, centered as a single group */
.pay button {
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-5) var(--card-pad);
  background: var(--color-surface);
  border: 3px solid var(--color-border-strong);
  border-radius: var(--r);
  box-shadow: var(--shadow);
}

/* Same icon-badge pattern as the dialog icons, at option-card scale */
.pay-icon {
  display: grid;
  place-items: center;
  width: 168px;
  height: 168px;
  margin-bottom: var(--sp-2);
  color: var(--color-primary);
  background: var(--color-accent-bg);
  border-radius: 50%;
}

.pay-icon svg {
  width: 88px;
  height: 88px;
}

.pay-name {
  font-size: 2.6rem;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: .02em;
  color: var(--color-text-heading);
}

.pay small {
  max-width: 13em;
  font-size: 1.3rem;
  font-weight: 500;
  line-height: 1.35;
  color: var(--color-text-secondary);
  text-wrap: balance;
}

.fact-value.is-amount {
  font-size: 3.6rem;
  font-variant-numeric: tabular-nums;
  color: var(--color-primary);
}

@media (max-width: 760px) {
  .pay {
    grid-template-columns: 1fr;
  }

.pay {
    flex: 0 0 auto;
    min-height: 0;
  }

.pay button {
    min-height: 200px;
    padding: var(--sp-4);
  }

.pay-icon {
    width: 104px;
    height: 104px;
    margin-bottom: 0;
  }

.pay-icon svg {
    width: 56px;
    height: 56px;
  }

.pay-name {
    font-size: 1.7rem;
  }

.fact-value.is-amount {
    font-size: 2.6rem;
  }
}

/* ==================== SCREEN: ORDER PLACED ==================== */
/* "Payment at the Stall": order details and Print Reference, with its printing spinner. */

.confirm-title {
  font-size: 2.6rem;
  font-weight: 900;
  line-height: 1.1;
  color: var(--color-success);
}

/* Label/value pairs: start-aligned labels, end-aligned values, sharing a text baseline */
.details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 var(--sp-5);
  font-size: 1.15rem;
  text-align: left;
}

.details.is-single {
  grid-template-columns: 1fr;
}

.spin {
  width: 1.3em;
  height: 1.3em;
  border: 3px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: sp .8s linear infinite;
}

.tick {
  display: grid;
  place-items: center;
  width: 140px;
  height: 140px;
  color: var(--color-text-on-primary);
  background: var(--color-success);
  border-radius: 50%;
  animation: pop .5s cubic-bezier(.3, 1.6, .5, 1);
}

.tick.still {
  animation: none;
}

.tick svg {
  width: 80px;
  height: 80px;
}

.details div {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-3);
  padding: var(--sp-2) 0;
  border-bottom: 1px solid var(--color-divider);
}

/* Label is secondary, value is primary: weight and colour carry the hierarchy */
.details span {
  font-weight: 500;
  color: var(--color-text-secondary);
}

.details b {
  min-width: 0;
  overflow-wrap: anywhere;      /* long stall names wrap instead of pushing the row wider */
  text-align: right;
}

@keyframes sp {
  to { transform: rotate(1turn); }
}

@media (max-width: 760px) {
  .details {
    grid-template-columns: 1fr;
  }

.confirm-title {
    font-size: 1.9rem;
  }
}

/* ==================== SCREEN: COMPLETE ==================== */
/* Final order screen: reference-slip badge, order number, order facts and the countdown to the rating. */

/* Primary action and the line that belongs to it stay together */
.confirm-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-2);
  width: min(100%, var(--measure));
}

/* Paired CTAs (Thank You: View Queue | Back to Home; Rating: Skip | Submit Rating): secondary left, primary right and slightly wider, same height */
.done-actions {
  display: flex;
  gap: var(--sp-3);
  width: min(100%, var(--measure));
}

.done-actions > * {
  flex: 1 1 0;
  padding-inline: var(--sp-3);
}

.done-actions > .btn-primary {
  flex-grow: 1.25;
}

/* Complete screen: the reference-slip badge. Same size and entrance as the check badge, but the accent badge
   pattern (gold disc, maroon icon) so it reads as an instruction, not a repeat of the success state */
.slip-badge {
  display: grid;
  place-items: center;
  width: 140px;
  height: 140px;
  color: var(--color-primary);
  background: var(--color-accent-bg);
  border-radius: 50%;
  animation: pop .5s cubic-bezier(.3, 1.6, .5, 1);
}

.slip-badge svg {
  width: 76px;
  height: 76px;
}

.pay-facts {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  padding: 0;
}

/* Shared card padding, so the text edge matches the cards above and below */
.pay-fact {
  display: flex;
  flex-direction: column;
  gap: .3rem;
  min-width: 0;
  padding: var(--card-pad);
}

.pay-fact + .pay-fact {
  border-left: 2px dashed var(--color-divider);
}

/* Order number: the one thing the customer must carry to the stall, so it is the largest element */
.order-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-5) var(--card-pad);
}

.order-no {
  font-size: 6rem;
  font-weight: 900;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: var(--color-primary);
}

/* Three-up variant of the fact strip: centered label/value pairs */
.pay-facts.is-3 {
  grid-template-columns: repeat(3, 1fr);
}

.pay-facts.is-3 .pay-fact {
  align-items: center;
  padding-inline: var(--sp-3);
  text-align: center;
}

@media (max-width: 760px) {
.order-no {
    font-size: 4rem;
  }

  /* Payment facts: single column */
.pay-facts,
  .pay-facts.is-3 {
    grid-template-columns: 1fr;
  }

.pay-fact {
    padding: 1rem 1.2rem;
  }

.pay-fact + .pay-fact {
    border-top: 2px dashed var(--color-divider);
    border-left: 0;
  }
}

/* ==================== SHARED STATES ==================== */
/* Interaction states for every screen. Kept after the SCREEN sections on purpose: like the original
   stylesheet, they come last so they override component rules of equal specificity. Choice buttons are
   .chip, .cat and the payment card (.pay button). */

button:active:not(:disabled) {
  transform: scale(.96);
}

/* Disabled: flat neutral fill and muted text, no shadow; reads as unavailable without relying on opacity */
button:disabled {
  color: var(--color-text-disabled);
  background: var(--color-surface-disabled);
  border-color: var(--color-border);
  box-shadow: none;
  cursor: not-allowed;
}

:focus-visible {
  outline: 4px solid var(--color-focus);
  outline-offset: 2px;
}

/* Immediate touch feedback for choice buttons (hover is not relied on) */
.chip:active:not([aria-pressed="true"]),
.cat:active:not([aria-pressed="true"]),
.pay button:active {
  background: var(--color-surface-hover);
  border-color: var(--color-primary);
}

@media (hover: hover) {
.pay button:hover { border-color: var(--color-primary); }

.btn-primary:hover:not(:disabled) { background: var(--color-primary-hover); }

.btn-secondary:hover:not(:disabled),
  .btn-quiet:hover:not(:disabled) { background: var(--color-secondary-hover); }

.btn-danger:hover:not(:disabled) { background: var(--color-error-hover); }

.chip:hover,
  .cat:hover { border-color: var(--color-primary); }
}

/* ==================== GLOBAL ANIMATIONS ==================== */
/* Screen-specific animations live with their screen (the spinner keyframes are in SCREEN: ORDER PLACED). */

@keyframes in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: none; }
}

@keyframes fade {
  from { opacity: 0; }
}

@keyframes fade-out {
  to { opacity: 0; }
}

@keyframes modal-in {
  from { opacity: 0; transform: scale(.97); }
  to   { opacity: 1; transform: none; }
}

@keyframes pop {
  from { transform: scale(0); }
}

@keyframes bump {
  50% { transform: scale(1.15); }
}

.bump {
  animation: bump .3s;
}

/* ==================== RESPONSIVE ==================== */
/* Shared and global responsive rules. Each screen's own responsive rules sit at the end of its SCREEN section. */

/* Phones and narrow windows: unlock the kiosk canvas and reflow to a single column.
   Keep the 760px breakpoint in sync with MOBILE_MAX in script.js. */
@media (max-width: 760px) {
:root {
    --fs: 16px;
    --page-pad: 1.25rem;
    --modal-pad: 1.5rem;
  }

body {
    place-items: stretch;
  }

.kiosk {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    border-radius: 0;
    box-shadow: none;
    transform: none;
  }

.screen-head h1 {
    font-size: 1.9rem;
  }

.lede {
    font-size: 1.1rem;
  }

  .grid {
    grid-template-columns: 1fr;
  }

.stage {
    padding-bottom: var(--sp-4);
  }

  /* Modals */
.overlay {
    padding: 1rem;
  }

.dialog-icon {
    width: 76px;
    height: 76px;
    margin-bottom: 1rem;
  }

.dialog-icon svg {
    width: 40px;
    height: 40px;
  }

.dialog-title {
    font-size: 1.8rem;
  }

.dialog-msg {
    font-size: 1.1rem;
  }

.dialog-actions {
    flex-direction: column;
  }

.dialog-actions > :only-child {
    flex-basis: auto;
  }

.mhead h2 {
    font-size: 1.5rem;
  }

.modal-foot .btn-lg {
    padding-inline: var(--sp-3);
    font-size: 1.3rem;
  }
}

/* Short viewports: compact the fixed regions so the scroll region keeps a usable height. Below about 480px
   tall no layout keeps header, controls and footer in view, so that is the supported minimum. */
@media (max-height: 700px) {
.screen-head {
    margin-bottom: var(--sp-3);
  }

.head-nav {
    min-height: 48px;
    margin-bottom: 0;
  }

.screen-head h1 {
    font-size: 1.5rem;
  }
}

@media (max-height: 560px) {
.lede {
    display: none;
  }
}

/* ==================== REDUCED MOTION ==================== */

@media (prefers-reduced-motion: reduce) {
* {
    animation: none !important;
    transition: none !important;
  }
}

/* ==================== SCREEN: KIOSK EXPERIENCE RATING ==================== */
/* One card of five rows; each row is a label above five large star targets. */

.rate-card {
  display: flex;
  flex-direction: column;
  padding-block: var(--sp-2);
}

.rate-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-3) 0;
  border-top: 1px solid var(--color-divider);
}

.rate-row:first-child {
  border-top: 0;
}

.rate-label {
  font-size: 1.4rem;
  font-weight: 900;
  line-height: 1.2;
  color: var(--color-text-heading);
}

.rate-row.is-missing .rate-label {
  color: var(--color-error-text);
}

.stars {
  display: flex;
  justify-content: center;
  gap: var(--sp-1);
  width: 100%;
}

/* The native radio covers the whole star, so the full square is the touch target */
.star {
  position: relative;
  display: grid;
  place-items: center;
  flex: 0 1 96px;
  aspect-ratio: 1;
  cursor: pointer;
}

.star input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  cursor: pointer;
  opacity: 0;
}

.star svg {
  width: 82%;
  height: 82%;
  pointer-events: none;
  fill: var(--color-surface);
  stroke: var(--color-border-strong);
  stroke-width: 1.5;
  stroke-linejoin: round;
  transition: fill var(--t-fast), stroke var(--t-fast), transform var(--t-fast);
}

.star.is-on svg {
  fill: var(--color-accent);
  stroke: var(--color-text-heading);
}

.star:active svg {
  transform: scale(.92);
}

.rate-row.is-missing .star:not(.is-on) svg {
  stroke: var(--color-error);
}

.star input:focus-visible + svg {
  outline: 4px solid var(--color-focus);
  outline-offset: 2px;
  border-radius: var(--r-sm);
}
